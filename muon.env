# Autocomp environment for the radiance Muon target.
#
# Usage:  source muon.env
#
# Secrets are pulled at source-time from ModelBlaster's .env (NOT copied here).
export $(grep ^AWS_BEARER_TOKEN_BEDROCK /scratch2/agustin/ModelBlaster/.env)
export $(grep ^WANDB_API_KEY /scratch2/agustin/ModelBlaster/.env)
export $(grep ^HF_TOKEN /scratch2/agustin/ModelBlaster/.env)
export $(grep ^GOOGLE_API_KEY /scratch2/agustin/ModelBlaster/.env)
export AWS_REGION=us-west-2

# ----- Budget: hard $250 cap (new-month reset 2026-07-14; prior $178.54 lifetime archived)
export AUTOCOMP_SPEND_LIMIT_USD=250
export AUTOCOMP_SPEND_LIMIT_MODE=stop
export AUTOCOMP_SPEND_LOG=$HOME/.autocomp/muon-spend.jsonl

# ----- Search tuning (run_search_muon reads these) -----------------------
# 12 iters / beam 3 (was 8/2): more exploration, affordable now that two-phase
# eval makes failed candidates cheap (~1s functional gate vs up to 180s timed).
export MUON_ITERS=12
export MUON_BEAM=3

# ----- Muon toolchain + simulator ----------------------------------------
export LLVM_MUON=/scratch2/agustin/radiance-kernels/llvm/llvm-muon
export RADIANCE_KERNELS=/scratch/agustin/projects/radiance-kernels
export CYCLOTRON_DIR=/scratch/agustin/projects/chipyard/generators/radiance/cyclotron
export CYCLOTRON_BIN=$CYCLOTRON_DIR/target/release/cyclotron
